{
  "name": "ffmpeg-konverter",
  "productName": "FFmpeg Konverter",
  "version": "1.0.0",
  "description": "Benutzerfreundlicher Video- und Audio-Konverter auf Basis von FFmpeg",
  "author": "fmatscheko",
  "license": "MIT",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "predev": "node scripts/fetch-realesrgan.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-realesrgan.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:all": "npm run build && electron-builder --mac --win --publish never",
    "gen:icons": "node scripts/generate-icons.mjs",
    "fetch:ai-model": "node scripts/fetch-realesrgan.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "i18next": "^23.16.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-electron": "^0.28.8"
  }
}
